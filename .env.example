# Frontend
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# API
API_PORT=3001
JWT_SECRET=altere-esta-chave-em-producao
JWT_EXPIRES_IN=7d
STAFF_JWT_EXPIRES_IN=8h
STAFF_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL=postgresql://fgcareers:fgcareers@localhost:5432/fgcareers?schema=public

# Storage (LOCAL | SUPABASE | RAILWAY)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_PATH=./packages/api/uploads

# Admin seed (dev)
ADMIN_EMAIL=admin@fgservices.com.br
ADMIN_PASSWORD=Admin@FG2026

# SendGrid
SENDGRID_API_KEY=sua_chave_sendgrid
SENDGRID_FROM_EMAIL=carreiras@fgservices.com.br
SENDGRID_FROM_NAME=FG Services Carreiras

# DocuSign (assinaturas eletrônicas no portal do candidato)
# Sandbox: https://demo.docusign.net | Produção: https://www.docusign.net
DOCUSIGN_INTEGRATION_KEY=sua_integration_key
DOCUSIGN_USER_ID=guid_do_usuario_api
DOCUSIGN_ACCOUNT_ID=guid_da_conta
# Chave RSA privada (JWT) — use \n para quebras de linha ou aponte para arquivo:
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# DOCUSIGN_PRIVATE_KEY_PATH=./secrets/docusign-private.key
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
# Template DocuSign (recomendado) OU PDF local em packages/api/templates/signatures/autodeclaracao.pdf
DOCUSIGN_TEMPLATE_ID_AUTODECLARACAO=
DOCUSIGN_TEMPLATE_ROLE=signer
# Webhook Connect (opcional, validação HMAC)
DOCUSIGN_CONNECT_HMAC_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=fg-careers
